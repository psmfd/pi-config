{
  "lastChangelogVersion": "0.84.1",
  "defaultProvider": "github-copilot",
  "defaultModel": "gpt-5.5",
  "defaultThinkingLevel": "medium",
  "extensionSettings": {
    "compactionOptimizer": {
      "mode": "hybrid"
    },
    "ghIdentityGuard": {
      "expectedIdentity": "<your-github-login>"
    },
    "githubRead": {
      "security": false,
      "notifications": false
    },
    "autoRouter": {
      "preferLocalOmlx": true
    },
    "localLlm": {
      "role": "full"
    },
    "repoDash": {
      "ciWidget": false
    },
    "tokenMeter": {
      "enabled": false
    },
    "worktree": {
      "enabled": true,
      "reportOnly": false,
      "baseRef": null,
      "snapshotIntervalMs": 300000,
      "writeExemptions": [
        "NEXT_SESSION*.md",
        ".review/**"
      ]
    }
  },
  "enabledModels": [
    "github-copilot/gpt-5.4-mini"
  ]
}
