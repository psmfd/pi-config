{
  "lastChangelogVersion": "0.84.2",
  "defaultProvider": "github-copilot",
  "defaultModel": "gpt-5.5",
  "defaultThinkingLevel": "medium",
  "extensionSettings": {
    "compactionOptimizer": {
      "mode": "hybrid"
    },
    "ghIdentityGuard": {
      "expectedIdentity": "<your-github-login>"
    },
    "githubRead": {
      "security": false,
      "notifications": false
    },
    "autoRouter": {
      "preferLocalOmlx": true
    },
    "bashConfinement": {
      "mode": "auto"
    },
    "localLlm": {
      "role": "full"
    },
    "payloadTuner": {
      "enabled": false,
      "rules": [
        {
          "match": {
            "provider": "omlx",
            "baseUrl": "http://host.lima.internal:8000/v1",
            "modelId": "coding-workhorse"
          },
          "apply": {
            "chatTemplateKwargs": {
              "reasoning_effort": "medium"
            }
          }
        }
      ]
    },
    "plainEnglish": {
      "enabled": false,
      "model": null,
      "timeoutMs": 30000,
      "minChars": 200,
      "maxChars": 60000
    },
    "repoDash": {
      "ciWidget": false
    },
    "tokenMeter": {
      "enabled": false
    },
    "worktree": {
      "enabled": true,
      "reportOnly": false,
      "baseRef": null,
      "snapshotIntervalMs": 300000,
      "writeExemptions": [
        "NEXT_SESSION*.md",
        ".review/**"
      ]
    }
  },
  "enabledModels": [
    "github-copilot/gpt-5.4-mini"
  ]
}
